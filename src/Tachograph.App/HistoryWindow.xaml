<Window x:Class="Tachograph.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tachograph history" Width="680" Height="470" MinWidth="560" MinHeight="400"
        Background="#16181B" WindowStartupLocation="CenterScreen" ShowActivated="False">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E9EEF2"/>
        <SolidColorBrush x:Key="Dim" Color="#7C8791"/>
        <FontFamily x:Key="Lcd">Bahnschrift, Segoe UI</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource Lcd}"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#23282D"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#2F353B"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Day navigation -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀" Style="{StaticResource Nav}" Click="Prev_Click" ToolTip="Previous day"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="DayTitle" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DaySub" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="2" Content="▶" Style="{StaticResource Nav}" Click="Next_Click" ToolTip="Next day"/>
        </Grid>

        <!-- 24 hour chart -->
        <Border Grid.Row="1" Margin="0,14,0,0" Background="#06080A" BorderBrush="#23282D" BorderThickness="1" CornerRadius="6">
            <Canvas x:Name="Chart" Height="190" SizeChanged="Chart_SizeChanged" ClipToBounds="True"/>
        </Border>

        <!-- Day totals -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,12,0,0">
            <StackPanel><TextBlock x:Name="DrivingTotal" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="DRIVING" FontSize="11" Foreground="#3FA9F5" HorizontalAlignment="Center"/></StackPanel>
            <StackPanel><TextBlock x:Name="WorkTotal" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="WORK" FontSize="11" Foreground="#F5A623" HorizontalAlignment="Center"/></StackPanel>
            <StackPanel><TextBlock x:Name="AvailTotal" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="AVAILABILITY" FontSize="11" Foreground="#A99BFF" HorizontalAlignment="Center"/></StackPanel>
            <StackPanel><TextBlock x:Name="RestTotal" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="REST" FontSize="11" Foreground="#4CC38A" HorizontalAlignment="Center"/></StackPanel>
        </UniformGrid>

        <!-- Week + violations -->
        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="WeekLine" FontSize="14"/>
                <TextBlock x:Name="WeekBar" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                <TextBlock Text="INFRINGEMENTS" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ViolationsText" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="4" Content="Export CSV..." HorizontalAlignment="Right" Padding="12,5" Margin="0,10,0,0"
                Background="#23282D" Foreground="#E9EEF2" BorderBrush="#2F353B" Click="Export_Click"/>
    </Grid>
</Window>