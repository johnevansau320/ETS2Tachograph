<Window x:Class="Tachograph.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 Tachograph" Width="460" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False"
        MouseLeftButtonDown="Drag">
    <Window.Resources>
        <SolidColorBrush x:Key="Bezel" Color="#16181B"/>
        <SolidColorBrush x:Key="Screen" Color="#06080A"/>
        <SolidColorBrush x:Key="Ink" Color="#E9EEF2"/>
        <SolidColorBrush x:Key="Dim" Color="#7C8791"/>
        <SolidColorBrush x:Key="Accent" Color="#3FA9F5"/>
        <FontFamily x:Key="Lcd">Bahnschrift, Segoe UI</FontFamily>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontFamily" Value="{StaticResource Lcd}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource Lcd}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PictoStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Ink}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bezel}" CornerRadius="14" Padding="10"
            BorderBrush="#2A2E33" BorderThickness="1">
        <Grid>
            <Border Background="{StaticResource Screen}" CornerRadius="6" BorderBrush="#23282D" BorderThickness="1">
                <Grid Margin="14,10,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: pictogram, activity, clock -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6"
                                BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="0,0,12,0">
                            <Grid Width="40" Height="40">
                                <!-- Driving: steering wheel -->
                                <Canvas x:Name="PicDriving" Visibility="Collapsed">
                                    <Ellipse Width="36" Height="36" Canvas.Left="2" Canvas.Top="2" Stroke="{StaticResource Ink}" StrokeThickness="3"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="16" Canvas.Top="16" Fill="{StaticResource Ink}"/>
                                    <Path Style="{StaticResource PictoStroke}" Data="M4,20 L16,20 M24,20 L36,20 M20,24 L20,38"/>
                                </Canvas>
                                <!-- Work: crossed hammers (simplified) -->
                                <Canvas x:Name="PicWork" Visibility="Collapsed">
                                    <Path Style="{StaticResource PictoStroke}" Data="M6,34 L26,14 M34,34 L14,14"/>
                                    <Path Style="{StaticResource PictoStroke}" Data="M22,6 L32,16 M18,6 L8,16"/>
                                </Canvas>
                                <!-- Availability: square split diagonally -->
                                <Canvas x:Name="PicAvailability" Visibility="Collapsed">
                                    <Rectangle Width="32" Height="32" Canvas.Left="4" Canvas.Top="4" Stroke="{StaticResource Ink}" StrokeThickness="3"/>
                                    <Path Style="{StaticResource PictoStroke}" Data="M4,36 L36,4"/>
                                </Canvas>
                                <!-- Rest: bed -->
                                <Canvas x:Name="PicRest">
                                    <Path Style="{StaticResource PictoStroke}" Data="M3,10 L3,32 M3,26 L37,26 L37,32 M3,20 L18,20 L18,26 M24,20 L37,20 L37,26"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="6" Canvas.Top="10" Fill="{StaticResource Ink}"/>
                                </Canvas>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityText" Text="REST" Foreground="{StaticResource Ink}"
                                       FontFamily="{StaticResource Lcd}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StateText" Text="Waiting for game" Foreground="{StaticResource Dim}"
                                       FontFamily="{StaticResource Lcd}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="--- --:--" Foreground="{StaticResource Ink}"
                                       FontFamily="{StaticResource Lcd}" FontSize="22" TextAlignment="Right"/>
                            <TextBlock x:Name="HotkeyText" Foreground="{StaticResource Dim}" FontSize="11"
                                       FontFamily="{StaticResource Lcd}" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Continuous driving bar -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="CONTINUOUS DRIVING" Style="{StaticResource Label}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="BreakText" Style="{StaticResource Label}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Ink}"/>
                        </Grid>
                        <ProgressBar x:Name="BreakBar" Height="10" Margin="0,4,0,0" Minimum="0" Maximum="270"
                                     Background="#1B2025" BorderThickness="0" Foreground="{StaticResource Accent}"/>
                    </StackPanel>

                    <!-- Three remaining-time tiles -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="DailyValue" Style="{StaticResource Value}" Text="--:--"/>
                            <TextBlock Style="{StaticResource Label}" Text="DAILY LEFT"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="WeekValue" Style="{StaticResource Value}" Text="--:--"/>
                            <TextBlock Style="{StaticResource Label}" Text="WEEK LEFT"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="FortValue" Style="{StaticResource Value}" Text="--:--"/>
                            <TextBlock Style="{StaticResource Label}" Text="2 WEEKS LEFT"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Footer: rest due -->
                    <Grid Grid.Row="3">
                        <TextBlock x:Name="RestDueText" Style="{StaticResource Label}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ReducedText" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Alert banner -->
            <Border x:Name="Banner" Visibility="Collapsed" VerticalAlignment="Top" Margin="6" CornerRadius="5"
                    Background="#B36B00" Padding="12,8">
                <TextBlock x:Name="BannerText" Foreground="White" FontFamily="{StaticResource Lcd}"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22"
                    Margin="0,-8,-8,0" Background="Transparent" Foreground="{StaticResource Dim}"
                    BorderThickness="0" Click="Close_Click" ToolTip="Quit"/>
        </Grid>
    </Border>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="History..." Click="History_Click"/>
            <MenuItem Header="Hotkeys..." Click="Hotkeys_Click"/>
            <MenuItem x:Name="SpeechItem" Header="Spoken warnings" IsCheckable="True" Click="Speech_Click"/>
            <MenuItem x:Name="TopItem" Header="Always on top" IsCheckable="True" Click="Top_Click"/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
            <MenuItem Header="Export history..." Click="Export_Click"/>
            <MenuItem Header="Check for updates..." Click="Update_Click"/>
            <MenuItem x:Name="VersionItem" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Quit" Click="Close_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
